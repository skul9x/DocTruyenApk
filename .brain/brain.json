      "vieneu_backbone_shared.data (100MB)",
      "vieneu_v3_heads.npz (50MB)",
      "moss_audio_tokenizer_decode_full.onnx (668KB)",
      "moss_audio_tokenizer_decode_shared.data (43MB)",
      "moss_audio_tokenizer_decode_step.onnx (344KB)",
      "denoiser.onnx (41MB)",
      "sea_g2p.bin (60MB)"
    ]
  },
