    {
      "name": "Automated CI/CD & Signed Release Pipeline",
      "status": "Implemented & Active",
      "components": [".github/workflows/android.yml", "app/build.gradle.kts (signingConfigs)"]
    }
  ],
  "decisions_made": [
    {
      "decision": "100% Offline On-Device on Android Phone",
      "reason": "Saves PC electricity (0 VND electricity/server cost), reads stories completely offline anywhere."
    },
    {
      "decision": "Use CPU ONNX int8 for VieNeu",
      "reason": "Extremely lightweight (~500MB RAM, 0% GPU VRAM overhead), fast enough on mobile CPU."
    },
    {
      "decision": "Chunking & Pre-buffering Pipeline",
      "reason": "Sentence-level chunking ensures time-to-first-audio ~2.2s and gapless playback between sentences."
    },
    {
      "decision": "Unified Audio Buffer per Chunk",
      "reason": "Combining synthesized speech with pause silence in a single buffer avoids polling starvation glitches."
    },
    {
      "decision": "Exclude private Keystore from Git",
      "reason": "Keystore is injected at build-time via GitHub Secrets Base64 decoding, preventing credential exposure."
    }
  ]
}
