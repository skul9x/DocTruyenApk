  "project": {
    "name": "VieNeu-TTS & DocTruyenApk Integration",
    "type": "Offline AI Text-to-Speech Mobile App",
    "status": "Production Ready with CI/CD Auto-Release & On-Device AI Benchmark Verified",
    "repository": "https://github.com/skul9x/DocTruyenApk.git"
  },
  "tech_stack": {
    "mobile_app": {
      "platform": "Android (Min SDK 24, Target SDK 35)",
      "language": "Kotlin 2.0",
      "architecture": "MVVM + Foreground Service (ReadingService)",
      "onnx_runtime": "com.microsoft.onnxruntime:onnxruntime-android:1.20.0",
      "audio_playback": "android.media.AudioTrack (48kHz 16-bit PCM Mono)"
    },
    "tts_engine": {
      "model": "VieNeu-TTS v3 Turbo",
      "precision": "int8 ONNX (CPU Execution Provider)",
      "sample_rate": 48000,
      "phonemizer": "sea-g2p (Rust cross-compiled to Android .so via cargo-ndk)",
      "codec": "MOSS-Audio-Tokenizer-Nano-ONNX"
    },
    "text_segmentation": {
      "module": "SmartTextSegmenter",
      "features": "Linguistic Vietnamese context-aware paragraph/sentence/clause/dialogue parsing, protected abbreviations (TP.HCM, BS., TS., GS.), numbers, and time formats"
    },
    "telemetry": {
      "module": "TtsMetricsLogger & DebugLogger",
      "metrics": "TTFT, RTF, inference time, audio duration, buffer underruns, queue dwell time"
    },
    "ci_cd": {
      "runner": "GitHub Actions (ubuntu-latest, JDK 17)",
      "workflow": ".github/workflows/android.yml",
      "features": "App name slugification, auto-increment minor tag versioning, Keystore base64 decoding & release signing, automated GitHub Releases"
    }
  },
  "model_artifacts": {
    "total_size_mb": 290,
    "backbone_dir": "app/src/main/assets/vieneu/backbone/",
    "files": [
